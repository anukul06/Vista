# SQLite for local dev — path is relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

API_PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Generate strong random secrets for real deployments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Seed data / bootstrap admin (only used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@vista.club
SEED_ADMIN_PASSWORD=change-me-now

# Cloudinary (Phase: storage) — leave blank until that phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub REST API (Phase: github integration) — optional, raises rate limits
GITHUB_TOKEN=
